# Секреты бота
BOT_TOKEN=your_bot_token_here

# База данных PostgreSQL
DATABASE_URL=postgresql+asyncpg://flipradar:password@db:5432/flipradar

# Redis
REDIS_URL=redis://redis:6379/0

# MTProto API (для внутреннего маркета Telegram)
# Получить на https://my.telegram.org
API_ID=your_api_id
API_HASH=your_api_hash
# Сессия Pyrogram (будет создана автоматически при первом запуске)
SESSION_STRING=

# Окружение
ENVIRONMENT=development

# Логирование
LOG_LEVEL=INFO
